rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isMaster() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "master";
    }

    function isShopOwnerOrMaster(userId) {
      return request.auth != null && (request.auth.uid == userId || isMaster());
    }

    function notOtherShopOwner(userId) {
      return request.auth == null || request.auth.uid == userId || isMaster();
    }

    function isActiveShopStaff(userId, staffId) {
      return staffId is string &&
        staffId.size() > 0 &&
        exists(/databases/$(database)/documents/users/$(userId)/staffs/$(staffId)) &&
        get(/databases/$(database)/documents/users/$(userId)/staffs/$(staffId)).data.isActive != false &&
        get(/databases/$(database)/documents/users/$(userId)/staffs/$(staffId)).data.status != "inactive";
    }

    function isAuthorizedTerminalStaff(userId, termData, staffId) {
      return termData != null &&
        termData.status == "active" &&
        termData.assignedStaffIds is list &&
        staffId in termData.assignedStaffIds &&
        isActiveShopStaff(userId, staffId);
    }

    function isAuthorizedTerminalStaffById(userId, terminalId, staffId) {
      return exists(/databases/$(database)/documents/users/$(userId)/terminals/$(terminalId)) &&
        isAuthorizedTerminalStaff(
          userId,
          get(/databases/$(database)/documents/users/$(userId)/terminals/$(terminalId)).data,
          staffId
        );
    }

    /* ================= ROOT STAFFS MIRROR ================= */
    match /staffs/{staffId} {
      allow read: if true;
      // Allow write if authenticated and acting on behalf of the owner
      allow write: if request.auth != null && (
        request.resource.data.ownerUid == request.auth.uid ||
        request.resource.data.masterUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        (resource != null && (
          resource.data.ownerUid == request.auth.uid ||
          resource.data.masterUid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        ))
      );
    }

    /* ================= KITCHEN ORDERS ================= */
    match /kitchen_orders/{orderId} {
      allow read, write: if true;
    }

    /* ================= DELIVERY ORDERS ================= */
    match /delivery_orders/{orderId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        request.resource.data.shopId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "master"
      );
      allow update: if request.auth != null;
      allow delete: if false;
    }

    /* ================= INVENTORY COLLECTION GROUP ================= */
    match /{path=**}/inventory/{itemId} {
      allow read: if true;
    }
    match /{path=**}/global_inventory/{itemId} {
      allow read: if true;
    }

    /* ================= USERS (STORES) ================= */
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "master"
      );

      /* Medicine & General Inventory */
      match /inventory/{itemId} {
        allow read, write: if true;
      }
      match /global_inventory/{itemId} {
        allow read, write: if true;
      }
      match /categories/{catId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      /* Restaurant Menu & Kitchen Orders */
      match /restaurant_menu/{itemId} {
        allow read, write: if true;
      }
      match /kitchen_orders/{orderId} {
        allow read, write: if true;
      }

      /* Local & Global Orders */
      match /local_orders/{orderId} {
        allow create, update: if request.auth != null;
        allow read: if true;
        allow delete: if false;
      }
      match /global_orders/{orderId} {
        allow create, update: if request.auth != null;
        allow read: if true;
        allow delete: if false;
      }
      match /orders/{orderId} {
        allow create, update: if request.auth != null;
        allow read: if true;
        allow delete: if false;
      }

      /* Store Staff Subcollection */
      match /staffs/{staffId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      /* ================= MEDICAL: HOSPITAL ROOM MANAGEMENT ================= */
      match /pharmacy_rooms/{roomId} {
        allow read: if true;
        allow write: if request.auth != null && (
          request.auth.uid == userId ||
          request.resource.data.ownerUid == userId
        );
      }

      match /pharmacy_room_categories/{catId} {
        allow read: if true;
        allow write: if request.auth != null && (
          request.auth.uid == userId ||
          request.resource.data.ownerUid == userId
        );
      }

      /* ================= MEDICAL: LABORATORY & DIAGNOSTIC TESTS ================= */
      match /lab_categories/{catId} {
        allow read: if true;
        allow write: if request.auth != null && (
          request.auth.uid == userId ||
          request.resource.data.ownerUid == userId
        );
      }

      match /lab_tests/{testId} {
        allow read: if true;
        allow write: if request.auth != null && (
          request.auth.uid == userId ||
          request.resource.data.ownerUid == userId
        );
      }

      /* Shop-Level Delivery Orders */
      match /delivery_orders/{orderId} {
        allow read: if true;
        allow create, update: if request.auth != null;
        allow delete: if false;
      }

      /* ================= POS SALES, ACTIVE CART & HELD ORDERS ================= */
      match /sales/{saleId} {
        allow read: if notOtherShopOwner(userId);
        allow create, update: if notOtherShopOwner(userId);
        allow delete: if false;
      }

      match /active_cart/{cartId} {
        allow read, write: if notOtherShopOwner(userId);
      }

      match /held_orders/{orderId} {
        allow read, write: if notOtherShopOwner(userId);
      }

      /* ================= FLOOR & POS TERMINAL ARCHITECTURE ================= */
      match /floors/{floorId} {
        allow read: if notOtherShopOwner(userId);
        allow create, update: if isShopOwnerOrMaster(userId) &&
          request.resource.data.shopId == userId;
        allow delete: if isShopOwnerOrMaster(userId);
      }

      match /terminals/{terminalId} {
        allow read: if notOtherShopOwner(userId);
        allow create: if isShopOwnerOrMaster(userId) &&
          request.resource.data.shopId == userId &&
          request.resource.data.floorId is string &&
          request.resource.data.code is string;
        allow delete: if isShopOwnerOrMaster(userId) &&
          resource.data.sessionStatus != "open";
        allow update: if (
          isShopOwnerOrMaster(userId) &&
          request.resource.data.shopId == userId
        ) || (
          notOtherShopOwner(userId) &&
          request.resource.data.shopId == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "sessionStatus",
            "currentSessionId",
            "activeStaffId",
            "activeStaffName",
            "lastActiveAt",
            "deviceInfo",
            "updatedAt"
          ]) &&
          isAuthorizedTerminalStaff(
            userId,
            resource.data,
            request.resource.data.activeStaffId != null
              ? request.resource.data.activeStaffId
              : resource.data.activeStaffId
          )
        );

        match /sessions/{sessionId} {
          allow read: if notOtherShopOwner(userId);
          allow create: if notOtherShopOwner(userId) &&
            request.resource.data.shopId == userId &&
            request.resource.data.terminalId == terminalId &&
            (
              isShopOwnerOrMaster(userId) ||
              isAuthorizedTerminalStaffById(userId, terminalId, request.resource.data.staffId)
            );
          allow update: if notOtherShopOwner(userId) &&
            request.resource.data.shopId == userId &&
            (
              isShopOwnerOrMaster(userId) ||
              isAuthorizedTerminalStaffById(userId, terminalId, resource.data.staffId)
            );
          allow delete: if false;
        }

        match /transactions/{transactionId} {
          allow read: if notOtherShopOwner(userId);
          allow create: if notOtherShopOwner(userId) &&
            request.resource.data.shopId == userId &&
            request.resource.data.terminalId == terminalId &&
            (
              isShopOwnerOrMaster(userId) ||
              isAuthorizedTerminalStaffById(userId, terminalId, request.resource.data.staffId)
            );
          allow update: if notOtherShopOwner(userId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "status",
              "refundReason",
              "refundedBy",
              "refundedAtMs",
              "updatedAt"
            ]) &&
            (
              isShopOwnerOrMaster(userId) ||
              isAuthorizedTerminalStaffById(userId, terminalId, resource.data.staffId)
            );
          allow delete: if false;
        }

        /* 🏷️ TERMINAL-SPECIFIC CATEGORIES */
        match /categories/{categoryId} {
          allow read: if notOtherShopOwner(userId);
          allow create, update: if isShopOwnerOrMaster(userId) &&
            request.resource.data.shopId == userId &&
            request.resource.data.terminalId == terminalId;
          allow delete: if isShopOwnerOrMaster(userId);
        }

        /* 🛍️ TERMINAL PRODUCT ASSIGNMENTS (MODEL A INDEPENDENT & MODEL B SHARED OVERRIDES) */
        match /products/{assignmentId} {
          allow read: if notOtherShopOwner(userId);
          allow create, update: if isShopOwnerOrMaster(userId) &&
            request.resource.data.shopId == userId &&
            request.resource.data.terminalId == terminalId &&
            (request.resource.data.productSource in ["independent", "shared"]) &&
            (request.resource.data.stockMode in ["independent", "shared"]);
          allow delete: if isShopOwnerOrMaster(userId);
        }

        /* 📦 TERMINAL INDEPENDENT STOCK LEDGER */
        match /inventory/{productId} {
          allow read: if notOtherShopOwner(userId);
          allow create, update: if notOtherShopOwner(userId) &&
            request.resource.data.shopId == userId &&
            request.resource.data.terminalId == terminalId &&
            (
              request.resource.data.stockQuantity >= 0 ||
              get(/databases/$(database)/documents/users/$(userId)).data.allowNegativeStock == true
            ) &&
            (
              isShopOwnerOrMaster(userId) ||
              isAuthorizedTerminalStaffById(userId, terminalId, request.resource.data.updatedByStaffId)
            );
          allow delete: if isShopOwnerOrMaster(userId);
        }
      }

      /* 📜 IMMUTABLE STOCK MOVEMENT AUDIT TRAIL */
      match /stock_movements/{movementId} {
        allow read: if notOtherShopOwner(userId);
        allow create: if notOtherShopOwner(userId) &&
          request.resource.data.shopId == userId &&
          (
            isShopOwnerOrMaster(userId) ||
            isAuthorizedTerminalStaffById(userId, request.resource.data.terminalId, request.resource.data.staffId)
          );
        allow update, delete: if false;
      }

      /* Default fallback for other subcollections */
      match /{subCollection}/{docId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    /* ================= CUSTOMERS ================= */
    match /customers/{customerId} {
      allow create, read: if true;
      allow update: if request.auth != null;
      allow delete: if false;

      match /orders/{orderId} {
        allow create, read, update: if request.auth != null;
        allow delete: if false;
      }
      match /cart/{cartDocId} {
        allow read, write: if request.auth != null && request.auth.uid == customerId;
      }
      match /saved_addresses/{addressId} {
        allow read, write: if request.auth != null;
      }
    }

    /* ================= PUBLIC SHOPS ================= */
    match /public_shops/{shopId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == shopId;
    }

    /* ================= SETTINGS ================= */
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /global_ids/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
