rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ================= ROOT STAFFS MIRROR ================= */
    match /staffs/{staffId} {
      allow read: if true;
      // Allow write if authenticated and acting on behalf of the owner
      allow write: if request.auth != null && (
        request.resource.data.ownerUid == request.auth.uid ||
        request.resource.data.masterUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        (resource != null && (
          resource.data.ownerUid == request.auth.uid ||
          resource.data.masterUid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        ))
      );
    }

    /* ================= KITCHEN ORDERS ================= */
    match /kitchen_orders/{orderId} {
      allow read, write: if true;
    }

    /* ================= DELIVERY ORDERS ================= */
    match /delivery_orders/{orderId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        request.resource.data.shopId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "master"
      );
      allow update: if request.auth != null;
      allow delete: if false;
    }

    /* ================= INVENTORY COLLECTION GROUP ================= */
    match /{path=**}/inventory/{itemId} {
      allow read: if true;
    }
    match /{path=**}/global_inventory/{itemId} {
      allow read: if true;
    }

    /* ================= USERS (STORES) ================= */
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "master"
      );

      /* Medicine & General Inventory */
      match /inventory/{itemId} {
        allow read, write: if true;
      }
      match /global_inventory/{itemId} {
        allow read, write: if true;
      }
      match /categories/{catId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      /* Restaurant Menu & Kitchen Orders */
      match /restaurant_menu/{itemId} {
        allow read, write: if true;
      }
      match /kitchen_orders/{orderId} {
        allow read, write: if true;
      }

      /* Local & Global Orders */
      match /local_orders/{orderId} {
        allow create, update: if request.auth != null;
        allow read: if true;
        allow delete: if false;
      }
      match /global_orders/{orderId} {
        allow create, update: if request.auth != null;
        allow read: if true;
        allow delete: if false;
      }
      match /orders/{orderId} {
        allow create, update: if request.auth != null;
        allow read: if true;
        allow delete: if false;
      }

      /* Store Staff Subcollection */
      match /staffs/{staffId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      /* ================= MEDICAL: HOSPITAL ROOM MANAGEMENT ================= */
      match /pharmacy_rooms/{roomId} {
        allow read: if true;
        allow write: if request.auth != null && (
          request.auth.uid == userId ||
          request.resource.data.ownerUid == userId
        );
      }

      match /pharmacy_room_categories/{catId} {
        allow read: if true;
        allow write: if request.auth != null && (
          request.auth.uid == userId ||
          request.resource.data.ownerUid == userId
        );
      }

      /* ================= MEDICAL: LABORATORY & DIAGNOSTIC TESTS ================= */
      match /lab_categories/{catId} {
        allow read: if true;
        allow write: if request.auth != null && (
          request.auth.uid == userId ||
          request.resource.data.ownerUid == userId
        );
      }

      match /lab_tests/{testId} {
        allow read: if true;
        allow write: if request.auth != null && (
          request.auth.uid == userId ||
          request.resource.data.ownerUid == userId
        );
      }

      /* Shop-Level Delivery Orders */
      match /delivery_orders/{orderId} {
        allow read: if true;
        allow create, update: if request.auth != null;
        allow delete: if false;
      }

      /* Default fallback for other subcollections */
      match /{subCollection}/{docId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    /* ================= CUSTOMERS ================= */
    match /customers/{customerId} {
      allow create, read: if true;
      allow update: if request.auth != null;
      allow delete: if false;

      match /orders/{orderId} {
        allow create, read, update: if request.auth != null;
        allow delete: if false;
      }
      match /cart/{cartDocId} {
        allow read, write: if request.auth != null && request.auth.uid == customerId;
      }
      match /saved_addresses/{addressId} {
        allow read, write: if request.auth != null;
      }
    }

    /* ================= PUBLIC SHOPS ================= */
    match /public_shops/{shopId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == shopId;
    }

    /* ================= SETTINGS ================= */
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /global_ids/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
